# ── Database ──────────────────────────────────────────────────────────────
# Use a hosted PostgreSQL provider (Neon, Supabase, Vercel Postgres, etc.)
DATABASE_URL="postgresql://user:password@host:5432/montgomery_command_center?sslmode=require"

# ── AI ────────────────────────────────────────────────────────────────────
# Google Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# ── Auth ──────────────────────────────────────────────────────────────────
# Strong random secret for JWT signing (openssl rand -hex 64)
JWT_SECRET="change-this-to-a-long-random-secret-in-production"

# ── Runtime ───────────────────────────────────────────────────────────────
NODE_ENV="production"
